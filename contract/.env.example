# Copy this file to .env and fill in real values.
# Never commit your .env file or your private key.

# ERC-20 USDT (or USDT-compatible) token address on the target chain
USDT_ADDRESS=0x0000000000000000000000000000000000000000

# Deployer key, used by `forge script ... --private-key $PRIVATE_KEY`
PRIVATE_KEY=0xyourprivatekeyhere